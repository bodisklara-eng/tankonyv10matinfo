ő</span><font color=\"#f8f8f2\">\njegyek[29] = </font><font color=\"#ae81ff\">9</font><font color=\"#f8f8f2\">;  </font><span style=\"color: rgb(117, 113, 94);\">// A harmincadik diák jegye jó</span><font color=\"#f8f8f2\">\n</font></pre>"},{"uid":"i8fc7984a","title":"<p>Java</p>","content":"<pre style=\"background-color: #2d2d2d; color: #f8f8f2; padding: 15px; border-radius: 5px; font-family: 'Courier New', monospace; font-size: 0.875rem; line-height: 1.5; border-left: 5px solid #e76f51; overflow-x: auto;\">\n<span style=\"color: #75715e;\">// 1. Deklaráció: Létrehozzuk a 30 rekeszes tömböt a memóriában</span>\n<span style=\"color: #66d9ef;\">int</span>[] jegyek = <span style=\"color: #f92672;\">new</span> <span style=\"color: #66d9ef;\">int</span>[30];\n\n<span style=\"color: #75715e;\">// 2. Értékadás: Az indexelés itt is 0-tól 29-ig tart</span>\njegyek[0] = <span style=\"color: #ae81ff;\">5</span>;   <span style=\"color: #75715e;\">// Első tanuló</span>\njegyek[29] = <span style=\"color: #ae81ff;\">3</span>;  <span style=\"color: #75715e;\">// Utolsó tanuló</span>\n</pre>"},{"uid":"ia1aa9b08","title":"<p>C++</p>","content":"<pre style=\"background-color: #2d2d2d; color: #f8f8f2; padding: 15px; border-radius: 5px; font-family: 'Courier New', monospace; font-size: 0.875rem; line-height: 1.5; border-left: 5px solid #00599c; overflow-x: auto;\">\n<span style=\"color: #f92672;\">#include</span> <span style=\"color: #e6db74;\">&lt;iostream&gt;</span>\n\n<span style=\"color: #66d9ef;\">int</span> <span style=\"color: #a6e22e;\">main</span>() {\n    <span style=\"color: #75715e;\">// 1. Deklaráció: Fix 30 elemű egész szám tömb létrehozása</span>\n    <span style=\"color: #66d9ef;\">int</span> jegyek[30];\n\n    <span style=\"color: #75715e;\">// 2. Értékadás: Rekeszek feltöltése indexek alapján</span>\n    jegyek[0] = <span style=\"color: #ae81ff;\">5</span>;   <span style=\"color: #75715e;\">// Első elem (0. index)</span>\n    jegyek[29] = <span style=\"color: #ae81ff;\">2</span>;  <span style=\"color: #75715e;\">// Utolsó elem (29. index)</span>\n    \n    <span style=\"color: #f92672;\">return</span> <span style=\"color: #ae81ff;\">0</span>;\n}\n</pre>"},{"uid":"i96af582a","title":"<p>Python</p>","content":"<pre style=\"background-color: #2d2d2d; color: #f8f8f2; padding: 15px; border-radius: 5px; font-family: 'Courier New', monospace; font-size: 0.875rem; line-height: 1.5; border-left: 5px solid #ffd43b; overflow-x: auto;\">\n<span style=\"color: #75715e;\"># 1. Deklaráció: Létrehozunk egy 30 elemű listát, kezdetben nullákkal feltöltve</span>\njegyek = [0] * <span style=\"color: #ae81ff;\">30</span>\n\n<span style=\"color: #75715e;\"># 2. Értékadás: Pythonban is 0 az első index, a 29 pedig az utolsó</span>\njegyek[0] = <span style=\"color: #ae81ff;\">5</span>   <span style=\"color: #75715e;\"># Első diák jegye</span>\njegyek[29] = <span style=\"color: #ae81ff;\">4</span>  <span style=\"color: #75715e;\"># Utolsó (30.) diák jegye</span>\n</pre>"}]},"help":"","language":"inherit","visual":{"theme":"default","identifiers":"element","css":"& { border-top-style:solid; border-right-style:solid; border-bottom-style:solid; border-left-style:solid; border-top-width:1px; border-right-width:1px; border-bottom-width:1px; border-left-width:1px; border-top-color:rgb(221, 221, 221); border-right-color:rgb(221, 221, 221); border-bottom-color:rgb(221, 221, 221); border-left-color:rgb(221, 221, 221); box-shadow:0px 2px 20px 4px rgba(0,0,0,0.1); padding: 20px 20px 50px 20px; } & button div { font-size: 12px; line-height: 20px; letter-spacing: 1.44px; padding: 10px; text-transform: uppercase; }","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"},"quizAnswerFormat":"inherit"},"id":"6a9061fef4ebf1922dfdde5e"},"6a90725df4ebf1922dfddf4a":{"type":"image","name":"MásolataMásolataKép_#3","title":"<p>Adjon meg egy címet...</p>","description":"","sources":{