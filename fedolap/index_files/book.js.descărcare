riáció</button><button onclick=\"setMode('comb')\">Kombináció</button></div>\n\n<div class=\"sim\" id=\"sim\">\n<div class=\"dot red\">&nbsp;</div>\n\n<div class=\"dot blue\">&nbsp;</div>\n\n<div class=\"dot green\">&nbsp;</div>\n</div>\n<style type=\"text/css\">.sim {\n    display: flex;\n    gap: 20px;\n    margin-top: 20px;\n    justify-content: center;\n  }\n  .dot {\n    width: 60px;\n    height: 60px;\n    border-radius: 50%;\n    opacity: 0.3;\n    transform: scale(1);\n  }\n  .red   { background: #ff3b3b; }\n  .blue  { background: #3b7bff; }\n  .green { background: #3bff6b; }\n\n  .flash {\n    animation: flash 0.6s forwards;\n  }\n  @keyframes flash {\n    0%   { opacity: 0.3; transform: scale(1); }\n    50%  { opacity: 1;   transform: scale(1.3); }\n    100% { opacity: 1;   transform: scale(1); }\n  }\n</style>\n<script>\nfunction reset() {\n  document.querySelectorAll('.dot').forEach(d => {\n    d.classList.remove('flash');\n  });\n}\n\nfunction setMode(mode) {\n  reset();\n  if (mode === 'perm') {\n    setTimeout(() => document.querySelector('.red').classList.add('flash'),   0);\n    setTimeout(() => document.querySelector('.blue').classList.add('flash'), 600);\n    setTimeout(() => document.querySelector('.green').classList.add('flash'),1200);\n  }\n  if (mode === 'var') {\n    setTimeout(() => document.querySelector('.blue').classList.add('flash'),  0);\n    setTimeout(() => document.querySelector('.green').classList.add('flash'),600);\n  }\n  if (mode === 'comb') {\n    setTimeout(() => document.querySelector('.red').classList.add('flash'),   0);\n    setTimeout(() => document.querySelector('.green').classList.add('flash'), 0);\n  }\n}\n</script>","visual":{"theme":"default","identifiers":"element","css":"","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}}},{"id":"i45ca1282","kind":"text","content":"<div class=\"stick\" onclick=\"this.classList.add('break');\">&nbsp;</div>\n<style type=\"text/css\">.stick {\n    --glow: #00e0ff;\n\n    width: 240px;\n    height: 26px;\n    margin: 40px auto;\n    border-radius: 999px;\n    background: #111;\n    border: 2px solid #333;\n    cursor: pointer;\n    position: relative;\n    transition: all 0.3s ease;\n  }\n\n  /* Törés animáció időzítése */\n  .stick.break {\n    animation:\n      shake 0.5s ease-out,\n      ignite 0.8s ease-out 0.5s forwards,\n      fadeout 2s ease-out 3s forwards;\n  }\n\n  /* 1. Rázkódás – villámcsapás stílus */\n  @keyframes shake {\n    0%   { transform: translateX(0) translateY(0) rotate(0deg); }\n    20%  { transform: translateX(-6px) translateY(-2px) rotate(-4deg); }\n    40%  { transform: translateX(6px)  translateY(2px)  rotate(4deg); }\n    60%  { transform: translateX(-4px) translateY(1px)  rotate(-2deg); }\n    80%  { transform: translateX(4px)  translateY(-1px) rotate(2deg); }\n    100% { transform: translateX(0) translateY(0) rotate(0deg); }\n  }\n\n  /* 2. Felizzás – lassú kémiai fényterjedés */\n  @keyframes ignite {\n    0% {\n      background: #111;\n      border-color: #333;\n      box-shadow: none;\n    }\n    100% {\n      background: radial-gradient(circle at 50% 50%, var(--glow) 0%, #001018 70%);\n      border-color: var(--glow);\n      box-shadow:\n        0 0 10px var(--glow),\n        0 0 25px var(--glow),\n        0 0 40px var(--glow);\n    }\n  }\n\n  /* 3. Halványulás – lassú kihunyás */\n  @keyframes fadeout {\n    0% {\n      box-shadow:\n        0 0 10px var(--glow),\n        0 0 25px var(--glow),\n        0 0 40px var(--glow);\n      opacity: 1;\n    }\n    100% {\n      box-shadow: none;\n      opacity: 0.3;\n    }\n  }\n\n  /* Repedésvonalak – három különböző szögben */\n  .stick.break::before,\n  .stick.break::after,\n  .stick.break .crack3 {\n    content: \"\";\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    width: 70%;\n    height: 2px;\n    background: rgba(255, 255, 255, 0.7);\n    box-shadow: 0 0 8px rgba(255, 255, 255, 0.9);\n    pointer-events: none;\n  }\n\n  .stick.break::before {\n    transform: translate(-50%, -50%) rotate(12deg);\n  }\n\n  .stick.break::after {\n    transform: translate(-50%, -50%) rotate(-10deg);\n  }\n\n  .stick.break .crack3 {\n    transform: translate(-50%, -50%) rotate(3deg);\n  }\n</style>","visual":{"theme":"default","identifiers":"element","css":"","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}}},{"id":"icf5a6ef2","kind":"text","content":"<div style=\"display: flex; justify-content: center; align-items: center; padding: 2rem; background-color: #0f172a; min-height: 150px;\"><!-- Csillogó gomb / link --><a class=\"glitter-btn\" href=\"https://red-zeta-one.vercel.app/elmelet9/index.html\" rel=\"noopener noreferrer\" target=\"_blank\">🚀 Megtekintés Vektor 2 </a>\n<style type=\"text/css\">.glitter-btn {\n            position: relative;\n            display: inline-block;\n            padding: 1rem 2rem;\n            font-size: 1rem;\n            font-weight: 600;\n            color: #ffffff;\n            text-decoration: none;\n            background: linear-gradient(135deg, #3b82f6, #1d4ed8);\n            border-radius: 0.5rem;\n            overflow: hidden;\n            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);\n            transition: transform 0.2s, box-shadow 0.2s;\n            font-family: system-ui, -apple-system, sans-serif;\n        }\n\n        /* A csillogó fénycsík effektsor */\n        .glitter-btn::after {\n            content: '';\n            position: absolute;\n            top: -50%;\n            left: -50%;\n            width: 200%;\n            height: 200%;\n            background: linear-gradient(\n                60deg,\n                transparent 30%,\n                rgba(255, 255, 255, 0.4) 50%,\n                transparent 70%\n            );\n            transform: rotate(30deg) translateX(-