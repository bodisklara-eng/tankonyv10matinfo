family: 'Segoe UI', system-ui, sans-serif;\n  color: #333333;\n  clear: both !important;\n  position: relative !important;\n  \n  /* --- BIZTONSÁGOS FÜGGŐLEGES GÖRGETÉS --- */\n  max-height: 650px; \n  overflow-y: auto !important; \n  overflow-x: hidden !important;\n  \n  /* ALAP ERŐS ARANY KERET */\n  border: 4px solid #ffd700 !important;\n  \n  /* --- ÖSSZETETT ANIMÁLT CSILLOGÓ ÉS VILLÓDZÓ EFFEKT --- */\n  animation: megaFlashGlow 4s ease-in-out infinite alternate;\n}\n\n/* Keret csillogás, pulzálás és finom villódzás animációja */\n@keyframes megaFlashGlow {\n  0% {\n    box-shadow: 0 0 10px rgba(255, 215, 0, 0.4), 0 0 20px rgba(255, 215, 0, 0.2);\n    border-color: #ffd700 !important;\n  }\n  45% {\n    box-shadow: 0 0 25px rgba(255, 165, 0, 0.6), 0 0 35px rgba(255, 215, 0, 0.3);\n    border-color: #ffa500 !important;\n  }\n  50% {\n    /* Egy pillanatnyi finom villanás (villódzó hatás) */\n    box-shadow: 0 0 35px rgba(255, 255, 255, 0.9), 0 0 50px rgba(255, 215, 0, 0.8);\n    border-color: #fff4b3 !important;\n  }\n  55% {\n    box-shadow: 0 0 25px rgba(255, 165, 0, 0.6), 0 0 35px rgba(255, 215, 0, 0.3);\n    border-color: #ffa500 !important;\n  }\n  100% {\n    box-shadow: 0 0 15px rgba(212, 175, 55, 0.5), 0 0 25px rgba(255, 215, 0, 0.2);\n    border-color: #b8860b !important;\n  }\n}\n\n/* Egyedi görgetősáv stílus a fő kártyához */\n.livresq-steam-mega-card::-webkit-scrollbar {\n  width: 8px;\n}\n.livresq-steam-mega-card::-webkit-scrollbar-track {\n  background: #f1f5f9;\n  border-radius: 4px;\n}\n.livresq-steam-mega-card::-webkit-scrollbar-thumb {\n  background: #cbd5e1;\n  border-radius: 4px;\n}\n.livresq-steam-mega-card::-webkit-scrollbar-thumb:hover {\n  background: #94a3b8;\n}\n\n/* Címsorok és alszekciók */\n.mega-card-main-title {\n  font-size: 1.375rem !important;\n  font-weight: 700 !important;\n  color: #0b6633 !important; /* Iskolai zöld */\n  margin-top: 0 !important;\n  margin-bottom: 20px !important;\n}\n\n.mega-card-section-title {\n  font-size: 1.063rem !important;\n  font-weight: 700 !important;\n  color: #b45309 !important; /* Meleg barna/narancs a szekcióknak */\n  margin-top: 25px !important;\n  margin-bottom: 12px !important;\n  display: block !important;\n  border-bottom: 1px solid #fed7aa !important;\n  padding-bottom: 4px !important;\n}\n\n/* Szövegek formázása */\n.mega-card-text {\n  display: block !important;\n  font-size: 0.938rem !important;\n  line-height: 1.6 !important;\n  color: #334155 !important;\n  margin-bottom: 14px !important;\n  text-align: justify !important;\n}\n\n/* Listák dizájnja */\n.livresq-steam-mega-card ul {\n  margin: 8px 0 16px 0 !important;\n  padding-left: 20px !important;\n  display: block !important;\n}\n\n.livresq-steam-mega-card li {\n  margin-bottom: 8px !important;\n  font-size: 0.906rem !important;\n  color: #475569 !important;\n  display: list-item !important;\n}\n\n.livresq-steam-mega-card li strong {\n  color: #1e293b !important;\n}\n\n/* Külső linkek kiemelése */\n.mega-card-link {\n  color: #0b6633 !important;\n  font-weight: 600 !important;\n  text-decoration: underline !important;\n  transition: color 0.2s !important;\n}\n\n.mega-card-link:hover {\n  color: #15803d !important;\n}\n\n/* Matematikai karakterek sávja */\n.mega-math-inline {\n  background-color: #f1f5f9 !important;\n  padding: 2px 6px !important;\n  border-radius: 4px !important;\n  font-family: monospace !important;\n  font-weight: bold !important;\n}\n</style>\n<div class=\"livresq-steam-mega-card\"><!-- FŐCÍM -->\n<div class=\"mega-card-main-title\">🌐 STEAM Oktatási Technológiák és Szimulációs Keretrendszerek</div>\n\n<p class=\"mega-card-text\">A Pythonon kívül számos modern technológia és fejlesztőkészlet létezik a szimuláció, a mátrixos matematika és az interaktív STEAM oktatási modellek megvalósítására.</p>\n<!-- 1. SZEKCIÓ --><span class=\"mega-card-section-title\">Webes és Kliensoldali Technológiák</span>\n\n<ul>\n\t<li><strong>JavaScript / TypeScript (p5.js vagy Three.js):</strong>\n\n\t<ul>\n\t\t<li><em>p5.js:</em> A Processing webes megfelelője. Kifejezetten oktatási, vizuális és interaktív kísérletekhez tervezett keretrendszer. Két-három soros kód segítségével kirajzolhatók a vízoszlopok, és a mátrixszorzások (math.js könyvtárral kiegészítve) valós időben futtathatók bármilyen böngészőben.</li>\n\t\t<li><em>Three.js:</em> Ha a 3D-s szökőkút-modellt (pl. Fusion 360-ból exportált OBJ/GLTF fájlokat) közvetlenül a böngészőben szeretnéd megjeleníteni, részecskerendszerrel (Particle System) és dinamikus vízsugarakkal.</li>\n\t</ul>\n\t</li>\n\t<li><strong>HTML5 Canvas / WebGL (Vaníla JS):</strong> Külső könyvtárak nélkül, tiszta HTML5 Canvas API-val is megrajzolható a szökőkút visualizer, a mátrixszerkesztő panel és a DMX-vezérlő. A grafikai számítások közvetlenül a GPU-n is futtathatók WebGL shader-ekkel (GLSL).</li>\n</ul>\n<!-- 2. SZEKCIÓ --> <span class=\"mega-card-section-title\">Vizuális és Blokkalapú Programozási Nyelvek (5–8. Osztály)</span>\n\n<ul>\n\t<li><strong>Scratch / Snap!:</strong> A mátrixot listák listájaként (2D tömb) kezelhetik a diákok. A fúvókákat külön szereplők (sprite-ok) jelenítik meg, melyek Y-pozíciója közvetlenül a mátrixszorzás eredményéből számítódik.<br />\n\t<em>Előny:</em> Nem kell szintaxissal küzdeni, a lineáris algebra és a szimulációs logika közvetlenül megérthető.</li>\n\t<li><strong>MakeCode / Micro:bit / Arduino (C++):</strong> Ha a virtuális szimulációt fizikai modellé alakítanátok át: egy micro:bit vagy Arduino mikrokontrolleren futó C++ kód végzi a mátrixszorzást, a kimenet pedig 5 darab szervómotort vagy LED-sávot (Neopixel) mozgat a vízmagasság vizualizálására.</li>\n</ul>\n<!-- 3. SZEKCIÓ --> <span class=\"mega-card-section-title\">Oktatási Szimulációs Szoftverek és Játékmotorok</span>\n\n<ul>\n\t<li><strong>Algodoo (2D Fizikai Szimulátor):</strong> Scriptor szoftveres nyelve (Thymio / Thyme script) lehetővé teszi, hogy a vízpárbajokat, szelepeket és fúvókákat valós fizikai folyadék-részecskékkel szimuláljátok. Az Algodoo egy svéd fejlesztésű (Algoryx Simulation által megalkotott), interaktív 2D-s fizikai szimulációs szoftver, amelyet kifejezetten oktatási célokra, kísérletezésre és játszva tanulásra terveztek. A program elődje a méltán híres Phun nevű szoftver volt.</li>\n\t<li><strong>Godot Engine (GDScript / C#):</strong> Könnyűsúlyú, nyílt forráskódú 2D/3D játékmotor. A GDScript szintaxisa nagyon hasonlít a Pythonhoz, de beépített grafikus UI elemekkel (gombok, csúszkák, textúrák) és 2D/3D fizikai motort biztosít.</li>\n\t<li><strong>Unity (C#):</strong> A profibb 9–12. osztályos projektekhez. Beépített VFX Graph és Particle System moduljaival fotorealisztikus vízsugarak modellezhetők, miközben a C# mátrixosztályai végezik a transzformációkat.</li>\n</ul>\n<!-- 4. SZEKCIÓ --> <span class=\"mega-card-section-title\">Műszaki és Tudományos Környezetek</span>\n\n<ul>\n\t<li><strong>MATLAB / GNU Octave:</strong> Mérnöki alapértelmezett környezet. A mátrixműveletek natívan integráltak <span class=\"mega-math-inline\">(x = M * x)</span>, a GUI pedig a Simulink vagy az App Designer felületén pár kattintással felépíthető.</li>\n\t<li><strong>C++ (SFML vagy Raylib könyvtárral):</strong> Alacsony szintű, rendkívül gyors végrehajtást biztosít. Kifejezetten hasznos, ha a szimulációt valós idejű DMX512 vagy Art-Net hálózati protokollal akarjátok összekötni fizikai szökőkút-hardverek irányításához.</li>\n</ul>\n<!-- 5. SZEKCIÓ --> <span class=\"mega-card-section-title\">Az Algodoo Fő Jellemzői és Képességei</span>\n\n<ul>\n\t<li><strong>Valós idejű fizikai motor:</strong> A szimuláció azonnal reagál a változtatásokra. A szoftver kiszámítja a gravitációt, a súrlódást, az ütközéseket, a légellenállást és a felületi feszültséget.</li>\n\t<li><strong>Folyadékszimuláció (Particles):</strong> Képes folyadékmolekulák ezreinek modellezésére. Kiválóan alkalmas szökőkutak, gátak, hidraulikus rendszerek vagy az Archimedesi csiga modellezésére.</li>\n\t<li><strong>Geometriai és mechanikai elemek:</strong> Szabadkézi rajzolás és alakzatok (körök, téglalapok, sokszögek), valamint tengelyek, rugók, kötelek, láncok, fogaskerekek, motorok és lézerek/prizmák.</li>\n\t<li><strong>Anyagtulajdonságok testreszabása:</strong> Bármelyik objektumnak megváltoztatható a sűrűsége, súrlódása, rugalmassága (visszapattanási tényezője) és színe. Akár speciális anyagok (pl. hélium, üzemanyag, víz, gumi, üveg) is beállíthatók.</li>\n</ul>\n<!-- 6. SZEKCIÓ --> <span class=\"mega-card-section-title\">Algodoo a STEAM és a Fizikaoktatásban</span>\n\n<p class=\"mega-card-text\">Az Algodoo kiváló híd az elméleti matematika/fizika és a gyakorlati mérnöki tervezés között:</p>\n\n<ul>\n\t<li><strong>Alsó és felső tagozat (5–8. osztály):</strong>\n\n\t<ul>\n\t\t<li><em>Szemléltetés:</em> Nyomás, felhajtóerő, optika (fénytörés prizmákon), valamint az energiamegmaradás törvényének szemléltetésére.</li>\n\t\t<li><em>Interaktivitás:</em> A diákok saját kézzel rajzolhatnak szökőkutakat, Rube Goldberg-gépeket vagy optikai kísérleteket.</li>\n\t</ul>\n\t</li>\n\t<li><strong>Középiskola (9–12. osztály) és programozás:</strong>\n\t<ul>\n\t\t<li><em>Thyme Scripting:</em> Az Algodoo saját scripthátterével (Thyme nyelv) az objektumok tulajdonságai kódból is vezérelhetők (pl. billentyűzet-eseményekre reagáló szelepek, egyenletek alapján változó erők).</li>\n\t\t<li><em>Adatelemzés:</em> Grafikonon ábrázolható a testek sebessége, gyorsulása, energiája vagy a ható erők az idő függvényében.</li>\n\t</ul>\n\t</li>\n</ul>\n<!-- 7. SZEKCIÓ --> <span class=\"mega-card-section-title\">Elérhetőség és Kompatibilitás</span>\n\n<ul>\n\t<li><strong>Ingyenesség:</strong> A szoftver PC-re (Windows és macOS) teljesen ingyenesen letölthető.</li>\n</ul>\n</div>","visual":{"theme":"default","identifiers":"element","css":"","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}}},{"id":"if8832067","kind":"row"