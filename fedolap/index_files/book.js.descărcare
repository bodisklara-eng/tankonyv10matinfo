ect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}}}],"visual":{"theme":"default","identifiers":"L-constrain-medium N-heading","css":"","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}},"bookmark":{"id":"bookmarkb5474a8f","content":"<p>Feladatleíró!</p>"}},{"id":"i4525b1a4","kind":"row","kids":[{"id":"i75717491","kind":"cell","kids":[{"id":"i0a5c8dd1","kind":"text","content":"<style type=\"text/css\">/* --- ANIMÁLT, CSILLOGÓ ÉS VILLÓDZÓ KÁRTYA KONTÉNER --- */\n.livresq-fairy-card {\n  display: block !important;\n  background-color: #ffffff !important;\n  border-radius: 12px !important; \n  padding: 30px !important;\n  max-width: 800px;\n  margin: 25px auto !important;\n  font-family: 'Segoe UI', system-ui, sans-serif;\n  color: #333333;\n  clear: both !important;\n  position: relative !important;\n  \n  /* ALAP ERŐS ARANY KERET */\n  border: 4px solid #ffd700 !important;\n  \n  /* --- ÖSSZETETT ANIMÁLT CSILLOGÓ ÉS VILLÓDZÓ EFFEKT --- */\n  animation: fairyFlashGlow 4s ease-in-out infinite alternate;\n}\n\n/* Keret csillogás, pulzálás és finom villódzás animációja */\n@keyframes fairyFlashGlow {\n  0% {\n    box-shadow: 0 0 10px rgba(255, 215, 0, 0.4), \n                0 0 20px rgba(255, 215, 0, 0.2);\n    border-color: #ffd700 !important;\n  }\n  45% {\n    box-shadow: 0 0 25px rgba(255, 165, 0, 0.6), \n                0 0 35px rgba(255, 215, 0, 0.3);\n    border-color: #ffa500 !important;\n  }\n  50% {\n    /* Egy pillanatnyi finom villanás (villódzó hatás) */\n    box-shadow: 0 0 35px rgba(255, 255, 255, 0.9), \n                0 0 50px rgba(255, 215, 0, 0.8);\n    border-color: #fff4b3 !important;\n  }\n  55% {\n    box-shadow: 0 0 25px rgba(255, 165, 0, 0.6), \n                0 0 35px rgba(255, 215, 0, 0.3);\n    border-color: #ffa500 !important;\n  }\n  100% {\n    box-shadow: 0 0 15px rgba(212, 175, 55, 0.5), \n                0 0 25px rgba(255, 215, 0, 0.2);\n    border-color: #b8860b !important;\n  }\n}\n\n/* Dobozon belüli egyedi cím formázása (Varázslatos tündérmese hangulat) */\n.fairy-card-title {\n  font-size: 1.25rem !important;\n  font-weight: 700 !important;\n  color: #b45309 !important; /* Meleg tónusú sötétnarancs/barna cím */\n  margin-top: 0 !important;\n  margin-bottom: 15px !important;\n  display: flex !important;\n  align-items: center !important;\n  gap: 8px !important;\n}\n\n/* Bekezdések és olvashatóság */\n.fairy-text-p {\n  display: block !important;\n  font-size: 0.969rem !important;\n  line-height: 1.65 !important;\n  color: #334155 !important; /* Jól olvasható pala-szürke */\n  margin-bottom: 16px !important;\n  text-align: justify !important;\n}\n\n/* Az utolsó bekezdésnek ne legyen felesleges alsó margója */\n.fairy-text-p:last-child {\n  margin-bottom: 0 !important;\n}\n\n/* Kiemelt analógia kulcsszavak (opcionális, de segíti a diákok figyelmét) */\n.fairy-highlight {\n  font-weight: 600;\n  color: #b45309;\n}\n</style>\n<!-- CSODÁSAN VILLÓDZÓ KÁRTYA TÖRZZSE -->\n<div class=\"livresq-fairy-card\"><!-- Varázslatos Cím -->\n<div class=\"fairy-card-title\">✨ Gondolatkísérlet: A postafiók és a jótündér</div>\n<!-- Első bekezdés: Tantermi helyzet -->\n\n<p class=\"fairy-text-p\">Ha megtekintetted a képeket, gondolj arra a helyzetre, amikor az osztályfőnök ráragasztja a diákok fiókjaira a jegyeiket. Ezek a papírfecnik azonban könnyen lepotyognának. Mivel egyes fiókok zárva vannak, a tanár nem tudta betenni az osztályzatokat, de ha be is tenné, nem minden diák venné észre, hová kerültek.</p>\n<!-- Második bekezdés: Postai és biztonsági analógia -->\n\n<p class=\"fairy-text-p\">Ha a postásnak adná, ő a postafiókok sorszáma szerint járna el. Viszont ha a postaládát senki sem üríti, nem ellenőrzik időnként, vagy valaki ellopja onnan a jegyet tartalmazó fecnit, a szülők és a diákok megint csak nem látnák az eredményt. Emiatt a szülők <span class=\"fairy-highlight\">riasztóberendezést szereltek a postaládára</span>, így Anna jegyét már senki sem tüntetheti el.</p>\n<!-- Harmadik bekezdés: A tündérmese lezárása -->\n\n<p class=\"fairy-text-p\">Anna eközben vígan bulizni készül. Hiába van rengeteg ruhája, mégsem találja az igazit. Ekkor megjelenik a <span class=\"fairy-highlight\">jótündér</span>, aki a rossz jegy helyett jót varázsol, a ruhákat pedig a helyükre igazítja...</p>\n</div>","visual":{"theme":"default","identifiers":"element","css":"","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}}},{"id":"6a928c6a17b435de55eaa894","kind":"image"},{"id":"i46c9e63a","kind":"text","content":"<style type=\"text/css\">/* --- ANIMÁLT, CSILLOGÓ ÉS VILLÓDZÓ KÁRTYA KONTÉNER --- */\n.livresq-fairy-card-part2 {\n  display: block !important;\n  background-color: #ffffff !important;\n  border-radius: 12px !important; \n  padding: 30px !important;\n  max-width: 800px;\n  margin: 25px auto !important;\n  font-family: 'Segoe UI', system-ui, sans-serif;\n  color: #333333;\n  clear: both !important;\n  position: relative !important;\n  \n  /* ALAP ERŐS ARANY KERET */\n  border: 4px solid #ffd700 !important;\n  \n  /* --- ÖSSZETETT ANIMÁLT CSILLOGÓ ÉS VILLÓDZÓ EFFEKT --- */\n  animation: fairyFlashGlow2 4s ease-in-out infinite alternate;\n}\n\n/* Keret csillogás, pulzálás és finom villódzás animációja */\n@keyframes fairyFlashGlow2 {\n  0% {\n    box-shadow: 0 0 10px rgba(255, 215, 0, 0.4), \n                0 0 20px rgba(255, 215, 0, 0.2);\n    border-color: #ffd700 !important;\n  }\n  45% {\n    box-shadow: 0 0 25px rgba(255, 165, 0, 0.6), \n                0 0 35px rgba(255, 215, 0, 0.3);\n    border-color: #ffa500 !important;\n  }\n  50% {\n    /* Egy pillanatnyi finom villanás (villódzó hatás) */\n    box-shadow: 0 0 35px rgba(255, 255, 255, 0.9), \n                0 0 50px rgba(255, 215, 0, 0.8);\n    border-color: #fff4b3 !important;\n  }\n  55% {\n    box-shadow: 0 0 25px rgba(255, 165, 0, 0.6), \n                0 0 35px rgba(255, 215, 0, 0.3);\n    border-color: #ffa500 !important;\n  }\n  100% {\n    box-shadow: 0 0 15px rgba(212, 175, 55, 0.5), \n                0 0 25px rgba(255, 215, 0, 0.2);\n    border-color: #b8860b !important;\n  }\n}\n\n/* Dobozon belüli cím (A valóság és a rendezési feladat) */\n.fairy-card-title-part2 {\n  font-size: 1.25rem !important;\n  font-weight: 700 !important;\n  color: #b45309 !important;\n  margin-top: 0 !important;\n  margin-bottom: 15px !important;\n  display: flex !important;\n  align-items: center !important;\n  gap: 8px !important;\n}\n\n/* Bekezdések és olvashatóság */\n.fairy-text-p-part2 {\n  display: block !important;\n  font-size: 0.969rem !important;\n  line-height: 1.65 !important;\n  color: #334155 !important;\n  margin-bottom: 16px !important;\n  text-align: justify !important;\n}\n\n.fairy-text-p-part2:last-child {\n  margin-bottom: 0 !important;\n}\n\n/* Kiemelt kulcsszavak az informatikai és rendezési analógiához */\n.fairy-highlight-part2 {\n  font-weight: 600;\n  color: #b45309;\n}\n</style>\n<!-- CSODÁSAN VILLÓDZÓ KÁRTYA FOLYTATÁSA -->\n<div class=\"livresq-fairy-card-part2\"><!-- Varázslatos/Realista Cím -->\n<div class=\"fairy-card-title-part2\">⚡ A valóság közbeszól: Digitális jegyek és a ruhakupac</div>\n<!-- Első bekezdés: Az iskolai rendszer és a bukott terv -->\n\n<p class=\"fairy-text-p-part2\">Sajnos a terv csak álom maradt. Az iskola ugyanis továbbsegítette a tanár nénit: az intézmény <span class=\"fairy-highlight-part2\">informatikai rendszere</span> azonnal továbbította a jegyeket a szülőknek, így Anna szülei is nyomban megkapták azokat.</p>\n<!-- Második bekezdés: A büntetés és az összekuszált sorrend -->\n\n<p class=\"fairy-text-p-part2\">Anna lelkesedése ekkor azonnal alábbhagyott, mivel a szüleitől azt a feladatot kapta, hogy tegyen ő maga rendet a ruhái között. A jótündér ugyanis korábban csupán sorrendbe rakta és <span class=\"fairy-highlight-part2\">felsorszámozta azokat</span>, ám a szülők a sorszámokkal együtt újból összekuszálták a ruhákat egyetlen hatalmas kupacba.</p>\n<!-- Harmadik bekezdés: Az elmaradt buli -->\n\n<p class=\"fairy-text-p-part2\">Bár Anna pontosan tudta, melyik ruhadarabokat hová illesztené, a nagy rengetegben már képtelen volt eligazodni, hiába kereste őket... Mire végül nagy nehezen rendet rakott, a buli már rég véget ért.</p>\n</div>","visual":{"theme":"default","identifiers":"element","css":"","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}}}],"visual":{"theme":"default","identifiers":"element","css":"","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}}}],"visual":{"theme":"default","identifiers":"L-constrain-medium","css":"","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}}},{"id":"icad6969d","kind":"row","kids":[{"id":"i21fafa1d","kind":"cell","kids":[{"id":"i3ab50b4e","kind":"text","content":"<h3>Hogyan gondolkodjunk?</h3>","visual":{"theme":"default","identifiers":"element","css":"& { padding-top: 0; padding-bottom: 0; }","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}}},{"id":"ie12f967f","kind":"text","content":"<style type=\"text/css\">/* Fő fehér kártya lekerekített sarkokkal és függőleges görgetéssel */\n.livresq-theory-card {\n  display: block !important;\n  background-color: #ffffff !important;\n  border-radius: 8px !important; \n  padding: 30px !important;\n  max-width: 850px;\n  \n  /* Függőleges görgetés korlátozása az oldal megnyúlása ellen */\n  max-height: 600px; \n  overflow-y: auto !important; \n  overflow-x: hidden !important;\n  \n  margin: 20px auto !important;\n  font-family: 'Segoe UI', system-ui, sans-serif;\n  color: #333333;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04) !important;\n  clear: both !important;\n}\n\n/* Modern függőleges görgetősáv stílus a kártyához */\n.livresq-theory-card::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n.livresq-theory-card::-webkit-scrollbar-track {\n  background: #f1f5f9;\n  border-radius: 4px;\n}\n.livresq-theory-card::-webkit-scrollbar-thumb {\n  background: #cbd5e1;\n  border-radius: 4px;\n}\n.livresq-theory-card::-webkit-scrollbar-thumb:hover {\n  background: #94a3b8;\n}\n\n/* Címsorok és blokkok formázása */\n.livresq-title-h3 {\n  font-size: 1.125rem !important;\n  font-weight: 700 !important;\n  color: #0b6633 !important; /* Tudományos zöld kiemelés */\n  margin-top: 25px !important;\n  margin-bottom: 12px !important;\n  display: block !important;\n}\n\n/* Sima folyószöveg paragrafusok */\n.livresq-text-p {\n  display: block !important;\n  font-size: 0.938rem !important;\n  line-height: 1.6 !important;\n  color: #444444 !important;\n  margin-bottom: 16px !important;\n  clear: both !important;\n}\n\n/* Listák és listaelemek biztonságos formázása */\n.livresq-theory-card ul {\n  margin: 8px 0 20px 0 !important;\n  padding-left: 20px !important;\n  display: block !important;\n}\n\n.livresq-theory-card li {\n  margin-bottom: 8px !important;\n  font-size: 0.906rem !important;\n  line-height: 1.5 !important;\n  display: list-item !important;\n}\n\n/* Belső listák eltolása */\n.livresq-theory-card li ul {\n  margin: 6px 0 6px 0 !important;\n  padding-left: 20px !important;\n}\n\n/* --- TÁBLÁZAT VÍZSZINTES GÖRGETÉSSEL (SCROLL) --- */\n.table-responsive {\n  overflow-x: auto !important;\n  width: 100% !important;\n  margin: 20px 0 !important;\n  border: 1px solid #e2e8f0 !important;\n  border-radius: 6px !important;\n}\n\n.livresq-table {\n  width: 100% !important;\n  min-width: 600px; /* Megakadályozza a cellák torzulását kis képernyőn */\n  border-collapse: collapse !important;\n  font-size: 0.875rem !important;\n  background-color: #ffffff !important;\n}\n\n.livresq-table th {\n  background-color: #f1f5f9 !important;\n  padding: 14px !important;\n  border-bottom: 2px solid #cbd5e1 !important;\n  font-weight: bold !important;\n  color: #1e293b !important;\n  text-align: left !important;\n}\n\n.livresq-table td {\n  padding: 12px 14px !important;\n  border-bottom: 1px solid #e2e8f0 !important;\n  vertical-align: top !important;\n  color: #4a5568 !important;\n  line-height: 1.5 !important;\n}\n\n.livresq-table tr:hover {\n  background-color: #f8fafc !important;\n}\n</style>\n<div class=\"livresq-theory-card\"><!-- Bevezető szöveg -->\n<p class=\"livresq-text-p\">A konkrét gondolkodásról az absztrakt (elvont) gondolkodásra való áttérés az emberi megismerés és fejlődés egyik legfontosabb lépése. A konkrét gondolkodás a kézzelfogható valóságra épít, míg az absztrakt gondolkodás képessé tesz minket a fizikai világon túli fogalmak megértésére.</p>\n\n<p class=\"livresq-text-p\">Íme a két gondolkodásmód részletes összehasanlítása, fejlődési íve és gyakorlati példái.</p>\n<!-- Főbb különbségek szekció --><span class=\"livresq-title-h3\">Főbb különbségek</span>\n\n<ul>\n\t<li><strong>Konkrét gondolkodás:</strong>\n\n\t<ul>\n\t\t<li>Érzékszervekkel tapasztalható dolgokra épül.</li>\n\t\t<li>Szó szerinti értelmezés jellemzi.</li>\n\t\t<li>A „itt és most” valóságára fókuszál.</li>\n\t\t<li>Fizikai objektumokhoz kötődik.</li>\n\t</ul>\n\t</li>\n\t<li><strong>Absztrakt gondolkodás:</strong>\n\t<ul>\n\t\t<li>Rejtett összefüggéseket keres.</li>\n\t\t<li>Szimbolikus jelentéseket értelmez.</li>\n\t\t<li>Elméleti lehetőségeket elemez.</li>\n\t\t<li>Fogalmakkal és elvekkel dolgozik.</li>\n\t</ul>\n\t</li>\n</ul>\n<!-- Gyakorlati példák szekció --> <span class=\"livresq-title-h3\">Gyakorlati példák az átmenetre</span> <!-- Görgethető táblázat konténer -->\n\n<div class=\"table-responsive\">\n<table class=\"livresq-table\">\n\t<thead>\n\t\t<tr>\n\t\t\t<th>Konkrét szint (Fizikai valóság)</th>\n\t\t\t<th>Absztrakt szint (Elvont fogalom)</th>\n\t\t</tr>\n\t</thead>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>Egy piros alma megnyalása.</td>\n\t\t\t<td>Az „egészség” vagy a „gyümölcs” kategóriája.</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>Két darab fizikai alma és még két darab fizikai alma.</td>\n\t\t\t<td>A <math><mn>2</mn><mo>+</mo><mn>2</mn><mo>=</mo><mn>4</mn></math> matematikai egyenlet.</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>Egy síró ember látványa.</td>\n\t\t\t<td>Az „empátia” vagy a „szomorúság” fogalma.</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td>„Aki korán kel, aranyat lel” – Korán kell felébredni, hogy pénzt találjunk.</td>\n\t\t\t<td>„Aki korán kel, aranyat lel” – A szorgalom meghozza a sikert.</td>\n\t\t</tr>\n\t</tbody>\n</table>\n</div>\n</div>","visual":{"theme":"default","identifiers":"element","css":"","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}}}],"visual":{"theme":"default","identifiers":"element","css":"","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}}}],"visual":{"theme":"default","identifiers":"L-constrain-medium N-heading","css":"","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}},"bookmark":{"id":"bookmark357067ca","content":"<p>Hogyan gondolkodjunk?</p>"}},{"id":"ibc76e327","kind":"row","kids":[{"id":"i798b7ede","kind":"cell","kids":[{"id":"i524a7ddd","kind":"text","content":"<style type=\"text/css\">/* --- ANIMÁLT, CSILLOGÓ ÉS VILLÓDZÓ KÁRTYA KONTÉNER --- */\n.livresq-fairy-card-part3 {\n  display: block !important;\n  background-color: #ffffff !important;\n  border-radius: 12px !important; \n  padding: 30px !important;\n  max-width: 800px;\n  margin: 25px auto !important;\n  font-family: 'Segoe UI', system-ui, sans-serif;\n  color: #333333;\n  clear: both !important;\n  position: relative !important;\n  \n  /* ALAP ERŐS ARANY KERET */\n  border: 4px solid #ffd700 !important;\n  \n  /* --- ÖSSZETETT ANIMÁLT CSILLOGÓ ÉS VILLÓDZÓ EFFEKT --- */\n  animation: fairyFlashGlow3 4s ease-in-out infinite alternate;\n}\n\n/* Keret csillogás, pulzálás és finom villódzás animációja */\n@keyframes fairyFlashGlow3 {\n  0% {\n    box-shadow: 0 0 10px rgba(255, 215, 0, 0.4), \n                0 0 20px rgba(255, 215, 0, 0.2);\n    border-color: #ffd700 !important;\n  }\n  45% {\n    box-shadow: 0 0 25px rgba(255, 165, 0, 0.6), \n                0 0 35px rgba(255, 215, 0, 0.3);\n    border-color: #ffa500 !important;\n  }\n  50% {\n    /* Egy pillanatnyi finom villanás (villódzó hatás) */\n    box-shadow: 0 0 35px rgba(255, 255, 255, 0.9), \n                0 0 50px rgba(255, 215, 0, 0.8);\n    border-color: #fff4b3 !important;\n  }\n  55% {\n    box-shadow: 0 0 25px rgba(255, 165, 0, 0.6), \n                0 0 35px rgba(255, 215, 0, 0.3);\n    border-color: #ffa500 !important;\n  }\n  100% {\n    box-shadow: 0 0 15px rgba(212, 175, 55, 0.5), \n                0 0 25px rgba(255, 215, 0, 0.2);\n    border-color: #b8860b !important;\n  }\n}\n\n/* Dobozon belüli cím (A tanárnő segítsége és a szavak nélküli módszerek) */\n.fairy-card-title-part3 {\n  font-size: 1.25rem !important;\n  font-weight: 700 !important;\n  color: #b45309 !important;\n  margin-top: 0 !important;\n  margin-bottom: 15px !important;\n  display: flex !important;\n  align-items: center !important;\n  gap: 8px !important;\n}\n\n/* Bekezdések és olvashatóság */\n.fairy-text-p-part3 {\n  display: block !important;\n  font-size: 0.969rem !important;\n  line-height: 1.65 !important;\n  color: #334155 !important;\n  margin-bottom: 16px !important;\n  text-align: justify !important;\n}\n\n.fairy-text-p-part3:last-child {\n  margin-bottom: 0 !important;\n}\n\n/* Kiemelt kulcsszavak az informatikai és pedagógiai analógiához */\n.fairy-highlight-part3 {\n  font-weight: 600;\n  color: #b45309;\n}\n</style>\n<!-- CSODÁSAN VILLÓDZÓ KÁRTYA HARMADIK RÉSZE -->\n<div class=\"livresq-fairy-card-part3\"><!-- Segítőkész, pedagógiai Cím -->\n<div class=\"fairy-card-title-part3\">💡 Új nap, új esély: Segítség szavak nélkül</div>\n<!-- Első bekezdés: A tanárnő felismerése -->\n\n<p class=\"fairy-text-p-part3\">Másnap Anna tanárnője már tudta, hogy a jegyek miatt otthon komoly zűrzavarok adódtak. Éppen ezért megpróbált segíteni a diákoknak a jobb osztályzatok megszerzésében.</p>\n<!-- Második bekezdés: Kooperáció és vizuális/szavak nélküli rávezetés -->\n\n<p class=\"fairy-text-p-part3\">Mindent megtett, hogy a kollégáival együtt olyan <span class=\"fairy-highlight-part3\">interaktív feladatokat</span> találjon ki, amelyek szavak nélkül, tisztán vizuális és logikai úton vezették rá a diákokat a helyes megoldásokra.</p>\n<!-- Harmadik bekezdés: Átvezetés a feladathoz -->\n\n<p class=\"fairy-text-p-part3\">Ez a módszer segített feloldani a feszültséget, miközben a gyerekek játszva sajátították el az összetett rendszerek működését. Nézzük meg, milyen <span class=\"fairy-highlight-part3\">algoritmikus rejtélyeket</span> kellett megoldaniuk!</p>\n</div>","visual":{"theme":"default","identifiers":"element","css":"","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}}},{"id":"id78aeacf","kind":"row","kids":[{"id":"i410eafd3","kind":"cell","kids":[{"id":"i01bc2729","kind":"text","content":"<style type=\"text/css\">/* --- ANIMÁLT, CSILLOGÓ ÉS VILLÓDZÓ KÁRTYA KONTÉNER --- */\n.livresq-fairy-card-part4 {\n  display: block !important;\n  background-color: #ffffff !important;\n  border-radius: 12px !important; \n  padding: 30px !important;\n  max-width: 850px;\n  margin: 25px auto !important;\n  font-family: 'Segoe UI', system-ui, sans-serif;\n  color: #333333;\n  clear: both !important;\n  position: relative !import