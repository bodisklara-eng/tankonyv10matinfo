rgba(255, 215, 0, 0.4), 0 0 20px rgba(255, 215, 0, 0.2); border-color: #ffd700 !important; }\n  45% { box-shadow: 0 0 25px rgba(255, 165, 0, 0.6), 0 0 35px rgba(255, 215, 0, 0.3); border-color: #ffa500 !important; }\n  50% { box-shadow: 0 0 35px rgba(255, 255, 255, 0.9), 0 0 50px rgba(255, 215, 0, 0.8); border-color: #fff4b3 !important; }\n  55% { box-shadow: 0 0 25px rgba(255, 165, 0, 0.6), 0 0 35px rgba(255, 215, 0, 0.3); border-color: #ffa500 !important; }\n  100% { box-shadow: 0 0 15px rgba(212, 175, 55, 0.5), 0 0 25px rgba(255, 215, 0, 0.2); border-color: #b8860b !important; }\n}\n\n/* Címek formázása */\n.livresq-nav-title {\n  font-size: 1.375rem !important;\n  font-weight: 700 !important;\n  color: #0b6633 !important;\n  margin-top: 0 !important;\n  margin-bottom: 8px !important;\n}\n\n.livresq-nav-subtitle {\n  font-size: 0.875rem !important;\n  color: #64748b !important;\n  margin-bottom: 24px !important;\n  line-height: 1.5;\n}\n\n/* --- KATEGÓRIA MENÜ VÍZSZINTES GÖRGETÉSSEL --- */\n.livresq-tabs-menu {\n  display: flex !important;\n  gap: 8px !important;\n  border-bottom: 2px solid #e2e8f0 !important;\n  padding-bottom: 10px !important;\n  margin-bottom: 20px !important;\n  overflow-x: auto !important;\n  white-space: nowrap !important;\n  -webkit-overflow-scrolling: touch;\n}\n\n.livresq-tabs-menu::-webkit-scrollbar {\n  height: 5px;\n}\n.livresq-tabs-menu::-webkit-scrollbar-track {\n  background: #f1f5f9;\n}\n.livresq-tabs-menu::-webkit-scrollbar-thumb {\n  background: #cbd5e1;\n  border-radius: 10px;\n}\n\n.livresq-tabs-menu label {\n  padding: 10px 16px !important;\n  font-size: 0.875rem !important;\n  font-weight: 600 !important;\n  color: #475569 !important;\n  background-color: #f8fafc !important;\n  border: 1px solid #e2e8f0 !important;\n  border-radius: 20px !important;\n  cursor: pointer !important;\n  transition: all 0.2s ease-in-out !important;\n  user-select: none !important;\n}\n\n.livresq-tabs-menu label:hover {\n  background-color: #f1f5f9 !important;\n  color: #0b6633 !important;\n}\n\n/* --- REJTETT RÁDIÓGOMBOK LOGIKÁJA --- */\n.livresq-inter-nav-card input[type=\"radio\"] {\n  display: none !important;\n}\n\n.livresq-tab-content {\n  display: none !important;\n  animation: fadeInContent 0.4s ease-in-out;\n}\n\n@keyframes fadeInContent {\n  from { opacity: 0; transform: translateY(5px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n#inter-tab1:checked ~ .livresq-tabs-menu label[for=\"inter-tab1\"],\n#inter-tab2:checked ~ .livresq-tabs-menu label[for=\"inter-tab2\"],\n#inter-tab3:checked ~ .livresq-tabs-menu label[for=\"inter-tab3\"],\n#inter-tab4:checked ~ .livresq-tabs-menu label[for=\"inter-tab4\"] {\n  background-color: #0b6633 !important;\n  color: #ffffff !important;\n  border-color: #0b6633 !important;\n}\n\n#inter-tab1:checked ~ .livresq-tab-container #content1,\n#inter-tab2:checked ~ .livresq-tab-container #content2,\n#inter-tab3:checked ~ .livresq-tab-container #content3,\n#inter-tab4:checked ~ .livresq-tab-container #content4 {\n  display: block !important;\n}\n\n/* --- TARTALOM FÜGGŐLEGES GÖRGETŐ DOBOZA --- */\n.livresq-tab-container {\n  display: block !important;\n  max-height: 450px !important;\n  overflow-y: auto !important;\n  padding-right: 8px !important;\n}\n\n.livresq-tab-container::-webkit-scrollbar {\n  width: 6px;\n}\n.livresq-tab-container::-webkit-scrollbar-track {\n  background: #f8fafc;\n}\n.livresq-tab-container::-webkit-scrollbar-thumb {\n  background: #cbd5e1;\n  border-radius: 4px;\n}\n\n/* --- INTERAKTÍV BLOKKOK FORMÁZÁSA --- */\n.livresq-block-item {\n  display: block !important;\n  padding: 18px !important;\n  margin-bottom: 15px !important;\n  background-color: #f8fafc !important;\n  border: 1px solid #e2e8f0 !important;\n  border-radius: 8px !important;\n}\n\n.livresq-block-title {\n  font-size: 1rem !important;\n  font-weight: 700 !important;\n  color: #1e293b !important;\n  margin-bottom: 6px !important;\n}\n\n.livresq-block-meta {\n  font-size: 0.875rem !important;\n  color: #4b5563 !important;\n  margin-bottom: 8px !important;\n  line-height: 1.4 !important;\n}\n\n.livresq-block-link {\n  display: inline-block !important;\n  color: #0b6633 !important;\n  font-weight: 600 !important;\n  font-size: 0.875rem !important;\n  text-decoration: underline !important;\n}\n\n.livresq-block-link:hover {\n  color: #15803d !important;\n}\n</style>\n<div class=\"livresq-inter-nav-card\">\n<div class=\"livresq-nav-title\">💻 Interaktív Egydimenziós Tömb Oktatás</div>\n\n<div class=\"livresq-nav-subtitle\">Válts a kategóriák között a gombok segítségével, és kattints a webhelyek linkjeire a játékos szimulációk és vizualizációk megnyitásához.</div>\n<!-- Rejtett rádiógombok a tiszta CSS vezérléshez --><input checked=\"checked\" id=\"inter-tab1\" name=\"inter-steam-tabs\" type=\"radio\" /> <input id=\"inter-tab2\" name=\"inter-steam-tabs\" type=\"radio\" /> <input id=\"inter-tab3\" name=\"inter-steam-tabs\" type=\"radio\" /> <input id=\"inter-tab4\" name=\"inter-steam-tabs\" type=\"radio\" /> <!-- VÍZSZINTESEN GÖRGETHETŐ MENÜ -->\n<div class=\"livresq-tabs-menu\"><label for=\"inter-tab1\">🎮 Blokkalapú &amp; Vizuális</label> <label for=\"inter-tab2\">💻 Szöveges &amp; Algoritmikus</label> <label for=\"inter-tab3\">🕹️ Játékalapú Kódolás</label> <label for=\"inter-tab4\">📝 Matematikai Integráció</label></div>\n<!-- FÜGGŐLEGESEN GÖRGETHETŐ TARTALOM TÁROLÓ -->\n\n<div class=\"livresq-tab-container\"><!-- 1. KATEGÓRIA TARTALMA (Blokkalapú és Vizuális) -->\n<div class=\"livresq-tab-content\" id=\"content1\">\n<div class=\"livresq-block-item\">\n<div class=\"livresq-block-title\">Code.org (App Lab / Game Lab)</div>\n\n<div class=\"livresq-block-meta\"><strong>Megközelítés:</strong> Kiváló bevezetés a listák és tömbök világába vizuális blokkokkal vagy JavaScript kóddal.</div>\n\n<div class=\"livresq-block-meta\"><strong>Interaktivitás:</strong> A diákok játékokat (pl. kvízeket, kattintós játékokat) fejlesztenek, ahol a tömb indexei közvetlenül a képernyőn lévő elemeket (képeket, pontszámokat) vezérlik.</div>\n<a class=\"livresq-block-link\" href=\"https://code.org\" target=\"_blank\">Ugrás a Code.org oldalra →</a></div>\n\n<div class=\"livresq-block-item\">\n<div class=\"livresq-block-title\">Scratch &amp; Snap! (MIT)</div>\n\n<div class=\"livresq-block-meta\"><strong>Megközelítés:</strong> A tömböket „Listák” néven kezelik.</div>\n\n<div class=\"livresq-block-meta\"><strong>Interaktivitás:</strong> Ideális a szökőkút-modell megértéséhez. A diákok létrehozhatnak egy 1D tömböt, ahol az <code>index</code> a fúvóka sorszáma, az <code>érték</code> pedig a vízmagasság. Egy egyszerű ciklussal a szereplők (sprite-ok) Y-pozíciója közvetlenül a tömbből olvasható ki.</div>\n<a class=\"livresq-block-link\" href=\"https://scratch.mit.edu\" target=\"_blank\">Ugrás a Scratch oldalra →</a></div>\n</div>\n<!-- 2. KATEGÓRIA TARTALMA (Szöveges és Algoritmikus) -->\n\n<div class=\"livresq-tab-content\" id=\"content2\">\n<div class=\"livresq-block-item\">\n<div class=\"livresq-block-title\">VisuAlgo (Visualising Data Structures and Algorithms)</div>\n\n<div class=\"livresq-block-meta\"><strong>Megközelítés:</strong> Az egyik legprofibb egyetemi és középiskolai vizualizációs eszköz.</div>\n\n<div class=\"livresq-block-meta\"><strong>Interaktivitás:</strong> Animálva mutatja be, mi történik az egydimenziós tömbök memóriacímeivel, amikor elemet szúrunk be, törlünk, vagy amikor elindítunk egy rendezési algoritmust. A kód futása lépésről lépésre követhető.</div>\n<a class=\"livresq-block-link\" href=\"https://visualgo.net/en/array\" target=\"_blank\">Ugrás a VisuAlgo oldalra →</a></div>\n\n<div class=\"livresq-block-item\">\n<div class=\"livresq-block-title\">Data Structure Visualizations (University of San Francisco)</div>\n\n<div class=\"livresq-block-meta\"><strong>Megközelítés:</strong> Minimál dizájn, maximális tudományos pontosság.</div>\n\n<div class=\"livresq-block-meta\"><strong>Interaktivitás:</strong> A tanuló saját maga gépelhet be értékeket egy tömbbe (Array). A rendszer vizuálisan, dobozokként ábrázolja a memóriát, és animálja az indexek változását keresés vagy módosítás közben.</div>\n<a class=\"livresq-block-link\" href=\"https://www.cs.usfca.edu/~galles/visualization/Algorithms.html\" target=\"_blank\">Ugrás az USF Visualizations oldalra →</a></div>\n</div>\n<!-- 3. KATEGÓRIA TARTALMA (Játékalapú Kódolás) -->\n\n<div class=\"livresq-tab-content\" id=\"content3\">\n<div class=\"livresq-block-item\">\n<div class=\"livresq-block-title\">CodeCombat</div>\n\n<div class=\"livresq-block-meta\"><strong>Megközelítés:</strong> Egy igazi RPG (szerepjáték), ahol a hősünket valódi programkóddal (Python, JavaScript) kell irányítani.</div>\n\n<div class=\"livresq-block-meta\"><strong>Interaktivitás:</strong> A sivatagi és erdei pályákon a diákok tömbökbe gyűjtik a környező ellenségeket vagy aranyérméket, majd indexek alapján választják ki, melyik célpontra támadjon a karakter.</div>\n<a class=\"livresq-block-link\" href=\"https://codecombat.com\" target=\"_blank\">Ugrás a CodeCombat oldalra →</a></div>\n\n<div class=\"livresq-block-item\">\n<div class=\"livresq-block-title\">CodinGame</div>\n\n<div class=\"livresq-block-meta\"><strong>Megközelítés:</strong> Középfokú és haladó diákoknak tervezett sci-fi környezet.</div>\n\n<div class=\"livresq-block-meta\"><strong>Interaktivitás:</strong> Olyan MI botokat kell programozni, amelyek tömbökben tárolják a radaradatokat, a fegyverek állapotát vagy a koordinátákat. Valós idejű grafikus visszajelzést ad a kód hatékonyságáról.</div>\n<a class=\"livresq-block-link\" href=\"https://www.codingame.com\" target=\"_blank\">Ugrás a CodinGame oldalra →</a></div>\n</div>\n<!-- 4. KATEGÓRIA TARTALMA (Matematikai Integráció) -->\n\n<div class=\"livresq-tab-content\" id=\"content4\">\n<div class=\"livresq-block-item\">\n<div class=\"livresq-block-title\">GeoGebra Materials</div>\n\n<div class=\"livresq-block-meta\"><strong>Megközelítés:</strong> A tiszta matematika és a lineáris algebra összekötése.</div>\n\n<div class=\"livresq-block-meta\"><strong>Interaktivitás:</strong> Kifejezetten alkalmas arra, hogy az egydimenziós tömböket vektorként, a kétdimenziós tömböket pedig mátrixként ábrázoljuk. A csúszkák mozgatásával a diákok azonnal látják, hogyan változik a geometriai tér vagy a ponthálózat.</div>\n<a class=\"livresq-block-link\" href=\"https://www.geogebra.org/materials\" target=\"_blank\">Ugrás a GeoGebra oldalra →</a></div>\n</div>\n</div>\n</div>","visual":{"theme":"default","identifiers":"element","css":"","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}}}],"visual":{"theme":"default","identifiers":"element","css":"","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}}}],"visual":{"theme":"default","identifiers":"L-constrain-medium N-heading","css":"","launcher":{"visibility":"default","position":"default"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}},"bookmark":{"id":"bookmark31d95933","content":"<p>Interaktív Egydimenziós Tömb Oktatás</p>"}},{"id":"i0afdff0c","kind":"row","kids":[{"id":"ia8516347","kind":"cell","kids":[{"id":"i23bb2f96","kind":"text","content":"<p><span id=\"ide1\"></span></p>\n\n<h2>Kezdj el programozni!</h2>","visual":{"theme":"default","identifiers":"element","css":"& { padding-top: 0; padding-bottom: 0; }","launcher":{"visibility":"show","position":"inherit"},"statusBar":"default","effect":{"name":"None","duration":500,"delay":0,"easing":"ease-in-out"}},"bookmark":{"id":"bookmark49a07554","content":"<p>Kezdj el programozni!</p>"}},{"id":"i0967101d","kind":"text","content":"<div style=\"display: flex; justify-content: center; align-items: center; padding: 2rem; background-color: #0f172a; min-height: 150px;\"><!-- Második típusú csillog